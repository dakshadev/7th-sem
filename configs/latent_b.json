{
  "objective": {
    "kind": "latent",
    "target": "top2_normalized",
    "predictor": "linear",
    "loss": "smooth_l1",
    "label": "B",
    "smooth_l1_beta": 1.0
  },
  "teacher": {
    "ema_decay": 0.996,
    "target_norm": "layernorm"
  },
  "mask": {
    "policy": "independent",
    "ratio": 0.15,
    "span_length": 3
  },
  "run": {
    "seed": 17,
    "token_budget": 5000000,
    "device": "cpu"
  },
  "_note": "Recipe B anchor: mean of normalized top-2 layer targets, independent masks, linear predictor, Smooth L1."
}
