{
  "objective": {
    "kind": "latent",
    "target": "top2_normalized",
    "predictor": "attention",
    "loss": "mse",
    "label": "D",
    "predictor_dropout": 0.1
  },
  "teacher": {
    "ema_decay": 0.996,
    "target_norm": "layernorm"
  },
  "mask": {
    "policy": "span",
    "ratio": 0.15,
    "span_length": 3
  },
  "run": {
    "seed": 17,
    "token_budget": 5000000,
    "device": "cpu"
  },
  "_note": "Ablation D: A with only B's teacher target (top-2 normalized). Everything else as A."
}